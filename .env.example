# Copiar para .env e alterar esta password ANTES de executar Docker.
# Utilizar apenas caracteres simples (letras/números/_/-) nesta fase, porque
# a password é interpolada na URL PostgreSQL do container API.
POSTGRES_PASSWORD=altera_esta_password_local_123
APP_PORT=8080
# Exclusivamente para testar Docker local em HTTP; exigir true com HTTPS em produção.
SESSION_COOKIE_SECURE=false
